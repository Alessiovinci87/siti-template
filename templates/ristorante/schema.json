{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dati cliente: template Ristorante / Bar",
  "type": "object",
  "additionalProperties": false,
  "required": ["template", "attivita", "contatti", "orari", "menu", "foto", "legale", "stile"],
  "properties": {
    "template": { "type": "string", "enum": ["ristorante"] },

    "attivita": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nome", "tipo", "slogan", "descrizione_breve", "chi_siamo"],
      "properties": {
        "nome": { "type": "string", "minLength": 2, "maxLength": 60 },
        "tipo": { "type": "string", "minLength": 2, "maxLength": 40, "description": "Es. Trattoria, Pizzeria, Ristorante di pesce, Bar" },
        "cucina": { "type": "string", "maxLength": 60, "description": "Es. Cucina sarda, Pesce, Pizza napoletana" },
        "slogan": { "type": "string", "minLength": 10, "maxLength": 90, "description": "Una frase sotto il nome, in alto nella home" },
        "descrizione_breve": { "type": "string", "minLength": 50, "maxLength": 160, "description": "Testo per Google (meta description), 50-160 caratteri" },
        "chi_siamo": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 40, "maxLength": 600 },
          "description": "Da 1 a 3 paragrafi"
        },
        "anno_apertura": { "type": "integer" },
        "servizi": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 2, "maxLength": 40 },
          "description": "Es. Tavoli all'aperto, Asporto, Opzioni vegane"
        }
      }
    },

    "contatti": {
      "type": "object",
      "additionalProperties": false,
      "required": ["telefono", "indirizzo"],
      "properties": {
        "telefono": { "type": "string", "pattern": "^\\+?[0-9 ./-]{6,20}$", "description": "Numero di telefono, es. +39 079 123 4567" },
        "whatsapp": { "type": "string", "pattern": "^\\+?[0-9 ./-]{6,20}$", "description": "Numero WhatsApp, es. +39 333 123 4567" },
        "messaggio_whatsapp": { "type": "string", "maxLength": 120, "description": "Testo precompilato del messaggio WhatsApp" },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", "description": "Indirizzo email valido" },
        "indirizzo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["via", "citta"],
          "properties": {
            "via": { "type": "string", "minLength": 3 },
            "cap": { "type": "string", "pattern": "^[0-9]{5}$", "description": "5 cifre" },
            "citta": { "type": "string", "minLength": 2 },
            "provincia": { "type": "string", "pattern": "^[A-Z]{2}$", "description": "Sigla in maiuscolo, es. SS" },
            "link_mappa": { "type": "string", "pattern": "^https://", "description": "Link alla scheda Google Maps (facoltativo)" },
            "indicazioni": { "type": "string", "maxLength": 200, "description": "Es. Parcheggio gratuito a 50 metri" }
          }
        },
        "social": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instagram": { "type": "string", "pattern": "^https://" },
            "facebook": { "type": "string", "pattern": "^https://" },
            "tripadvisor": { "type": "string", "pattern": "^https://" },
            "thefork": { "type": "string", "pattern": "^https://" }
          }
        }
      }
    },

    "orari": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lun", "mar", "mer", "gio", "ven", "sab", "dom"],
      "properties": {
        "lun": { "$ref": "#/$defs/giorno" },
        "mar": { "$ref": "#/$defs/giorno" },
        "mer": { "$ref": "#/$defs/giorno" },
        "gio": { "$ref": "#/$defs/giorno" },
        "ven": { "$ref": "#/$defs/giorno" },
        "sab": { "$ref": "#/$defs/giorno" },
        "dom": { "$ref": "#/$defs/giorno" },
        "note": { "type": "string", "maxLength": 200, "description": "Es. Chiuso a gennaio per ferie" }
      }
    },

    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categorie"],
      "properties": {
        "intro": { "type": "string", "maxLength": 300 },
        "categorie": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nome", "piatti"],
            "properties": {
              "nome": { "type": "string", "minLength": 2, "maxLength": 40 },
              "piatti": {
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["nome", "prezzo"],
                  "properties": {
                    "nome": { "type": "string", "minLength": 2, "maxLength": 70 },
                    "descrizione": { "type": "string", "maxLength": 160 },
                    "prezzo": {
                      "anyOf": [{ "type": "number" }, { "type": "string", "minLength": 1, "maxLength": 20 }],
                      "description": "un numero (es. 12 o 12.5) oppure un testo breve (es. \"a peso\")"
                    },
                    "tag": {
                      "type": "array",
                      "items": { "type": "string", "enum": ["vegetariano", "vegano", "senza glutine", "piccante", "della casa", "stagionale"] }
                    }
                  }
                }
              }
            }
          }
        },
        "nota_allergeni": { "type": "string", "maxLength": 300 },
        "coperto": { "type": "string", "maxLength": 60 }
      }
    },

    "foto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["copertina", "sala", "piatti"],
      "properties": {
        "logo": { "type": "string", "description": "Nome del file del logo (facoltativo), preferibilmente SVG o PNG" },
        "copertina": { "$ref": "#/$defs/foto" },
        "sala": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/foto" } },
        "piatti": { "type": "array", "minItems": 4, "maxItems": 8, "items": { "$ref": "#/$defs/foto" } },
        "team": { "$ref": "#/$defs/foto" }
      }
    },

    "legale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ragione_sociale", "piva"],
      "properties": {
        "ragione_sociale": { "type": "string", "minLength": 2 },
        "piva": { "type": "string", "pattern": "^[0-9]{11}$", "description": "11 cifre, senza IT" },
        "sede_legale": { "type": "string" },
        "email_privacy": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" }
      }
    },

    "stile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variante"],
      "properties": {
        "variante": { "type": "string", "enum": ["terra", "mare", "notte"] }
      }
    },

    "seo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "titolo": { "type": "string", "minLength": 20, "maxLength": 65, "description": "Titolo per Google, se diverso da quello automatico (massimo 65 caratteri)" },
        "parole_chiave": { "type": "array", "maxItems": 12, "items": { "type": "string" }, "description": "Parole chiave scelte per i testi (da npm run seo)" }
      }
    },

    "google": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "categoria_principale": { "type": "string", "minLength": 3 },
        "categorie_secondarie": { "type": "array", "maxItems": 9, "items": { "type": "string" } },
        "descrizione": { "type": "string", "minLength": 100, "maxLength": 750, "description": "Descrizione per la scheda Google Business, massimo 750 caratteri, senza link" }
      }
    },

    "gestione": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attiva"],
      "properties": {
        "attiva": { "type": "boolean", "description": "Piano Plus: il cliente può modificare prezzi, disponibilità, piatto del giorno e avviso" }
      }
    },

    "sito": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dominio": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$", "description": "Es. trattoriarossi.it, senza https://" }
      }
    }
  },

  "$defs": {
    "giorno": {
      "type": "array",
      "maxItems": 3,
      "description": "Fasce orarie del giorno. Vuoto = chiuso.",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "orario nel formato HH:MM, es. 19:30" }
      }
    },
    "foto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "alt"],
      "properties": {
        "file": { "type": "string", "minLength": 3 },
        "alt": { "type": "string", "minLength": 5, "maxLength": 140, "description": "Descrizione della foto per chi non vede e per Google" }
      }
    }
  }
}
